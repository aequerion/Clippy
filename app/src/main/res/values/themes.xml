<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Clippy" parent="android:Theme.Material.NoActionBar">
        <!-- Primary colors -->
        <item name="android:colorPrimary">@color/accent_green</item>
        <item name="android:colorPrimaryDark">@color/accent_green_dark</item>
        <item name="android:colorAccent">@color/accent_green</item>
        
        <!-- Background colors -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.Clippy.Splash" parent="Theme.Clippy">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>